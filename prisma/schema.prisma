generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model GiftTypeProductCategory {
  id                  Int             @id @default(autoincrement())
  gift_type_id        Int
  product_category_id Int
  gift_type           gifttype        @relation(fields: [gift_type_id], references: [id], onDelete: Cascade)
  product_category    productcategory @relation(fields: [product_category_id], references: [id], onDelete: Cascade)

  @@unique([gift_type_id, product_category_id])
  @@index([product_category_id])
  @@map("gift_type_product_categories")
}

model cart {
  id         Int        @id @default(autoincrement())
  user_id    Int
  session_id String?
  status     String     @default("active")
  created_at DateTime   @default(now())
  updated_at DateTime
  user       user       @relation(fields: [user_id], references: [id], map: "Cart_user_id_fkey")
  cartitem   cartitem[]

  @@index([user_id], map: "Cart_user_id_fkey")
}

model cartitem {
  id         Int      @id @default(autoincrement())
  cart_id    Int
  product_id Int
  quantity   Int
  unit_price Decimal  @db.Decimal(10, 2)
  line_total Decimal  @db.Decimal(10, 2)
  created_at DateTime @default(now())
  updated_at DateTime
  cart       cart     @relation(fields: [cart_id], references: [id], map: "CartItem_cart_id_fkey")
  product    product  @relation(fields: [product_id], references: [id], map: "CartItem_product_id_fkey")

  @@index([cart_id], map: "CartItem_cart_id_fkey")
  @@index([product_id], map: "CartItem_product_id_fkey")
}

model city {
  id       Int     @id
  name     String
  province String?
}

model customeraddress {
  id                    Int      @id @default(autoincrement())
  user_id               Int
  label                 String?
  full_name             String
  phone                 String
  alternative_phone     String?
  address_line_1        String
  address_line_2        String?
  city                  String
  area                  String
  postal_code           String?
  delivery_instructions String?
  latitude              Float?
  longitude             Float?
  is_default            Boolean  @default(false)
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime
  user                  user     @relation(fields: [user_id], references: [id], map: "CustomerAddress_user_id_fkey")

  @@index([user_id], map: "CustomerAddress_user_id_fkey")
}

model decorbooking {
  id                        Int                          @id @default(autoincrement())
  user_id                   Int
  decor_package_id          Int
  event_type_id             Int
  booking_number            String                       @unique(map: "DecorBooking_booking_number_key")
  event_date                DateTime
  event_start_time          String?
  event_end_time            String?
  guest_count               Int?
  venue_type                String?
  venue_name                String?
  theme_preferences         String?
  customer_notes            String?
  package_starting_price    Decimal                      @db.Decimal(10, 2)
  transport_charge          Decimal                      @db.Decimal(10, 2)
  quoted_amount             Decimal?                     @db.Decimal(10, 2)
  final_amount              Decimal?                     @db.Decimal(10, 2)
  booking_status            decorbooking_booking_status  @default(pending)
  payment_method            decorbooking_payment_method?
  payment_status            decorbooking_payment_status  @default(pending)
  created_at                DateTime                     @default(now())
  updated_at                DateTime
  decorpackage              decorpackage                 @relation(fields: [decor_package_id], references: [id], map: "DecorBooking_decor_package_id_fkey")
  eventtype                 eventtype                    @relation(fields: [event_type_id], references: [id], map: "DecorBooking_event_type_id_fkey")
  user                      user                         @relation(fields: [user_id], references: [id], map: "DecorBooking_user_id_fkey")
  decorbookingpayment       decorbookingpayment[]
  decorbookingstatushistory decorbookingstatushistory[]
  decorbookingvenue         decorbookingvenue?
  decorquotation            decorquotation[]
  decorreview               decorreview[]
  decorteamassignment       decorteamassignment[]
  notification              notification[]

  @@index([decor_package_id], map: "DecorBooking_decor_package_id_fkey")
  @@index([event_type_id], map: "DecorBooking_event_type_id_fkey")
  @@index([user_id], map: "DecorBooking_user_id_fkey")
}

model decorbookingpayment {
  id               Int                                @id @default(autoincrement())
  decor_booking_id Int
  payment_type     decorbookingpayment_payment_type
  payment_method   decorbookingpayment_payment_method
  amount           Decimal                            @db.Decimal(10, 2)
  currency         String
  transaction_id   String?
  status           decorbookingpayment_status         @default(pending)
  paid_at          DateTime?
  created_at       DateTime                           @default(now())
  updated_at       DateTime
  decorbooking     decorbooking                       @relation(fields: [decor_booking_id], references: [id], map: "DecorBookingPayment_decor_booking_id_fkey")

  @@index([decor_booking_id], map: "DecorBookingPayment_decor_booking_id_fkey")
}

model decorbookingstatushistory {
  id                 Int                                       @id @default(autoincrement())
  decor_booking_id   Int
  changed_by_user_id Int?
  previous_status    decorbookingstatushistory_previous_status
  new_status         decorbookingstatushistory_new_status
  note               String?
  created_at         DateTime                                  @default(now())
  user               user?                                     @relation(fields: [changed_by_user_id], references: [id], map: "DecorBookingStatusHistory_changed_by_user_id_fkey")
  decorbooking       decorbooking                              @relation(fields: [decor_booking_id], references: [id], map: "DecorBookingStatusHistory_decor_booking_id_fkey")

  @@index([changed_by_user_id], map: "DecorBookingStatusHistory_changed_by_user_id_fkey")
  @@index([decor_booking_id], map: "DecorBookingStatusHistory_decor_booking_id_fkey")
}

model decorbookingvenue {
  id                  Int          @id @default(autoincrement())
  decor_booking_id    Int          @unique(map: "DecorBookingVenue_decor_booking_id_key")
  customer_address_id Int?
  contact_name        String
  contact_phone       String
  alternative_phone   String?
  venue_name          String?
  address_line_1      String
  address_line_2      String?
  city                String
  area                String
  postal_code         String?
  venue_instructions  String?
  latitude            Float?
  longitude           Float?
  created_at          DateTime     @default(now())
  decorbooking        decorbooking @relation(fields: [decor_booking_id], references: [id], map: "DecorBookingVenue_decor_booking_id_fkey")
}

model decorcategory {
  id                Int                  @id @default(autoincrement())
  event_type_id     Int
  name              String
  slug              String               @unique(map: "DecorCategory_slug_key")
  short_description String?
  description       String?
  image_url         String?
  image_public_id   String?
  image_alt_text    String?
  meta_title        String?
  meta_description  String?
  sort_order        Int
  status            decorcategory_status @default(draft)
  is_visible        Boolean              @default(false)
  created_at        DateTime             @default(now())
  updated_at        DateTime
  eventtype         eventtype            @relation(fields: [event_type_id], references: [id], map: "DecorCategory_event_type_id_fkey")
  decorpackage      decorpackage[]

  @@index([event_type_id], map: "DecorCategory_event_type_id_fkey")
}

model decorpackage {
  id                    Int                 @id @default(autoincrement())
  decor_category_id     Int
  name                  String
  slug                  String              @unique(map: "DecorPackage_slug_key")
  package_code          String              @unique(map: "DecorPackage_package_code_key")
  short_description     String?
  description           String
  included_items        String              @db.LongText
  excluded_items        String?             @db.LongText
  terms_and_conditions  String?
  starting_price        Decimal             @db.Decimal(10, 2)
  sale_price            Decimal?            @db.Decimal(10, 2)
  estimated_setup_hours Int?
  maximum_guests        Int?
  service_city          String?
  average_rating        Float               @default(0)
  reviews_count         Int                 @default(0)
  is_featured           Boolean             @default(false)
  is_visible            Boolean             @default(true)
  status                decorpackage_status @default(draft)
  meta_title            String?
  meta_description      String?
  created_at            DateTime            @default(now())
  updated_at            DateTime
  decorbooking          decorbooking[]
  decorcategory         decorcategory       @relation(fields: [decor_category_id], references: [id], map: "DecorPackage_decor_category_id_fkey")
  decorpackageimage     decorpackageimage[]
  decorreview           decorreview[]

  @@index([decor_category_id], map: "DecorPackage_decor_category_id_fkey")
}

model decorpackageimage {
  id               Int          @id @default(autoincrement())
  decor_package_id Int
  image_url        String
  public_id        String?
  alt_text         String?
  sort_order       Int
  is_primary       Boolean      @default(false)
  is_visible       Boolean      @default(true)
  created_at       DateTime     @default(now())
  updated_at       DateTime
  decorpackage     decorpackage @relation(fields: [decor_package_id], references: [id], map: "DecorPackageImage_decor_package_id_fkey")

  @@index([decor_package_id], map: "DecorPackageImage_decor_package_id_fkey")
}

model decorquotation {
  id                 Int                   @id @default(autoincrement())
  decor_booking_id   Int
  quotation_number   String                @unique(map: "DecorQuotation_quotation_number_key")
  package_amount     Decimal               @db.Decimal(10, 2)
  transport_charge   Decimal               @db.Decimal(10, 2)
  additional_charge  Decimal               @db.Decimal(10, 2)
  discount_amount    Decimal               @db.Decimal(10, 2)
  total_amount       Decimal               @db.Decimal(10, 2)
  notes              String?
  valid_until        DateTime?
  status             decorquotation_status @default(draft)
  created_by_user_id Int
  accepted_at        DateTime?
  rejected_at        DateTime?
  created_at         DateTime              @default(now())
  updated_at         DateTime
  user               user                  @relation(fields: [created_by_user_id], references: [id], map: "DecorQuotation_created_by_user_id_fkey")
  decorbooking       decorbooking          @relation(fields: [decor_booking_id], references: [id], map: "DecorQuotation_decor_booking_id_fkey")

  @@index([created_by_user_id], map: "DecorQuotation_created_by_user_id_fkey")
  @@index([decor_booking_id], map: "DecorQuotation_decor_booking_id_fkey")
}

model decorreview {
  id                  Int          @id @default(autoincrement())
  decor_booking_id    Int
  decor_package_id    Int
  user_id             Int
  rating              Int
  description         String
  status              String       @default("pending")
  is_verified_booking Boolean      @default(false)
  admin_reply         String?
  admin_replied_at    DateTime?
  created_at          DateTime     @default(now())
  updated_at          DateTime
  decorbooking        decorbooking @relation(fields: [decor_booking_id], references: [id], map: "DecorReview_decor_booking_id_fkey")
  decorpackage        decorpackage @relation(fields: [decor_package_id], references: [id], map: "DecorReview_decor_package_id_fkey")
  user                user         @relation(fields: [user_id], references: [id], map: "DecorReview_user_id_fkey")

  @@index([decor_booking_id], map: "DecorReview_decor_booking_id_fkey")
  @@index([decor_package_id], map: "DecorReview_decor_package_id_fkey")
  @@index([user_id], map: "DecorReview_user_id_fkey")
}

model decorteamassignment {
  id                                                 Int                                   @id @default(autoincrement())
  decor_booking_id                                   Int
  assigned_user_id                                   Int
  assigned_by_user_id                                Int
  role_name                                          String
  assignment_status                                  decorteamassignment_assignment_status @default(assigned)
  assigned_at                                        DateTime                              @default(now())
  accepted_at                                        DateTime?
  completed_at                                       DateTime?
  created_at                                         DateTime                              @default(now())
  updated_at                                         DateTime
  user_decorteamassignment_assigned_by_user_idTouser user                                  @relation("decorteamassignment_assigned_by_user_idTouser", fields: [assigned_by_user_id], references: [id], map: "DecorTeamAssignment_assigned_by_user_id_fkey")
  user_decorteamassignment_assigned_user_idTouser    user                                  @relation("decorteamassignment_assigned_user_idTouser", fields: [assigned_user_id], references: [id], map: "DecorTeamAssignment_assigned_user_id_fkey")
  decorbooking                                       decorbooking                          @relation(fields: [decor_booking_id], references: [id], map: "DecorTeamAssignment_decor_booking_id_fkey")

  @@index([assigned_by_user_id], map: "DecorTeamAssignment_assigned_by_user_id_fkey")
  @@index([assigned_user_id], map: "DecorTeamAssignment_assigned_user_id_fkey")
  @@index([decor_booking_id], map: "DecorTeamAssignment_decor_booking_id_fkey")
}

model deliveryotp {
  id             Int       @id @default(autoincrement())
  order_id       Int
  user_id        Int
  otp_hash       String
  expires_at     DateTime
  attempt_count  Int       @default(0)
  verified_at    DateTime?
  invalidated_at DateTime?
  created_at     DateTime  @default(now())
  order          order     @relation(fields: [order_id], references: [id], map: "DeliveryOtp_order_id_fkey")
  user           user      @relation(fields: [user_id], references: [id], map: "DeliveryOtp_user_id_fkey")

  @@index([order_id], map: "DeliveryOtp_order_id_fkey")
  @@index([user_id], map: "DeliveryOtp_user_id_fkey")
}

model deliveryzone {
  id                         Int      @id @default(autoincrement())
  name                       String
  city                       String
  area                       String
  delivery_charge            Decimal  @db.Decimal(10, 2)
  minimum_order_amount       Decimal  @db.Decimal(10, 2)
  free_delivery_minimum      Decimal? @db.Decimal(10, 2)
  estimated_min_minutes      Int?
  estimated_max_minutes      Int?
  cash_on_delivery_available Boolean  @default(true)
  is_active                  Boolean  @default(true)
  created_at                 DateTime @default(now())
  updated_at                 DateTime
  order                      order[]
}

model eventtype {
  id                Int              @id @default(autoincrement())
  name              String
  slug              String           @unique(map: "EventType_slug_key")
  short_description String?
  description       String?
  image_url         String?
  image_public_id   String?
  image_alt_text    String?
  meta_title        String?
  meta_description  String?
  sort_order        Int
  status            eventtype_status @default(draft)
  is_visible        Boolean          @default(false)
  created_at        DateTime         @default(now())
  updated_at        DateTime
  decorbooking      decorbooking[]
  decorcategory     decorcategory[]
}

model gifttype {
  id                Int                       @id @default(autoincrement())
  name              String
  slug              String                    @unique(map: "GiftType_slug_key")
  description       String?
  image_url         String?
  image_public_id   String?
  image_alt_text    String?
  meta_title        String?
  meta_description  String?
  sort_order        Int
  status            gifttype_status           @default(draft)
  is_visible        Boolean                   @default(false)
  created_at        DateTime                  @default(now())
  updated_at        DateTime
  productCategories GiftTypeProductCategory[]
}

model notification {
  id               Int                 @id @default(autoincrement())
  user_id          Int
  order_id         Int?
  decor_booking_id Int?
  type             String
  channel          String
  title            String
  message          String
  status           notification_status @default(pending)
  sent_at          DateTime?
  read_at          DateTime?
  created_at       DateTime            @default(now())
  decorbooking     decorbooking?       @relation(fields: [decor_booking_id], references: [id], map: "Notification_decor_booking_id_fkey")
  order            order?              @relation(fields: [order_id], references: [id], map: "Notification_order_id_fkey")
  user             user                @relation(fields: [user_id], references: [id], map: "Notification_user_id_fkey")

  @@index([decor_booking_id], map: "Notification_decor_booking_id_fkey")
  @@index([order_id], map: "Notification_order_id_fkey")
  @@index([user_id], map: "Notification_user_id_fkey")
}

model order {
  id                   Int                    @id @default(autoincrement())
  user_id              Int
  delivery_zone_id     Int
  order_number         String                 @unique(map: "Order_order_number_key")
  subtotal             Decimal                @db.Decimal(10, 2)
  delivery_charge      Decimal                @db.Decimal(10, 2)
  discount_amount      Decimal                @db.Decimal(10, 2)
  tax_amount           Decimal                @db.Decimal(10, 2)
  grand_total          Decimal                @db.Decimal(10, 2)
  payment_method       order_payment_method
  payment_status       order_payment_status   @default(pending)
  order_status         order_order_status     @default(pending)
  customer_note        String?
  delivery_date        DateTime?
  delivery_time_slot   String?
  placed_at            DateTime               @default(now())
  confirmed_at         DateTime?
  ready_at             DateTime?
  picked_up_at         DateTime?
  delivered_at         DateTime?
  cancelled_at         DateTime?
  created_at           DateTime               @default(now())
  updated_at           DateTime
  deliveryotp          deliveryotp[]
  notification         notification[]
  deliveryzone         deliveryzone           @relation(fields: [delivery_zone_id], references: [id], map: "Order_delivery_zone_id_fkey")
  user                 user                   @relation(fields: [user_id], references: [id], map: "Order_user_id_fkey")
  orderdeliveryaddress orderdeliveryaddress?
  orderitem            orderitem[]
  orderriderassignment orderriderassignment[]
  orderstatushistory   orderstatushistory[]
  payment              payment[]

  @@index([delivery_zone_id], map: "Order_delivery_zone_id_fkey")
  @@index([user_id], map: "Order_user_id_fkey")
}

model orderdeliveryaddress {
  id                    Int      @id @default(autoincrement())
  order_id              Int      @unique(map: "OrderDeliveryAddress_order_id_key")
  customer_address_id   Int?
  full_name             String
  phone                 String
  alternative_phone     String?
  address_line_1        String
  address_line_2        String?
  city                  String
  area                  String
  postal_code           String?
  delivery_instructions String?
  latitude              Float?
  longitude             Float?
  created_at            DateTime @default(now())
  order                 order    @relation(fields: [order_id], references: [id], map: "OrderDeliveryAddress_order_id_fkey")
}

model orderitem {
  id                Int             @id @default(autoincrement())
  order_id          Int
  product_id        Int?
  product_name      String
  product_slug      String?
  product_sku       String
  primary_image_url String?
  unit_price        Decimal         @db.Decimal(10, 2)
  quantity          Int
  line_total        Decimal         @db.Decimal(10, 2)
  created_at        DateTime        @default(now())
  order             order           @relation(fields: [order_id], references: [id], map: "OrderItem_order_id_fkey")
  productreview     productreview[]

  @@index([order_id], map: "OrderItem_order_id_fkey")
}

model orderriderassignment {
  id                                                  Int       @id @default(autoincrement())
  order_id                                            Int
  rider_user_id                                       Int
  assigned_by_user_id                                 Int
  status                                              String    @default("assigned")
  assigned_at                                         DateTime  @default(now())
  accepted_at                                         DateTime?
  picked_up_at                                        DateTime?
  completed_at                                        DateTime?
  created_at                                          DateTime  @default(now())
  updated_at                                          DateTime
  user_orderriderassignment_assigned_by_user_idTouser user      @relation("orderriderassignment_assigned_by_user_idTouser", fields: [assigned_by_user_id], references: [id], map: "OrderRiderAssignment_assigned_by_user_id_fkey")
  order                                               order     @relation(fields: [order_id], references: [id], map: "OrderRiderAssignment_order_id_fkey")
  user_orderriderassignment_rider_user_idTouser       user      @relation("orderriderassignment_rider_user_idTouser", fields: [rider_user_id], references: [id], map: "OrderRiderAssignment_rider_user_id_fkey")

  @@index([assigned_by_user_id], map: "OrderRiderAssignment_assigned_by_user_id_fkey")
  @@index([order_id], map: "OrderRiderAssignment_order_id_fkey")
  @@index([rider_user_id], map: "OrderRiderAssignment_rider_user_id_fkey")
}

model orderstatushistory {
  id                 Int                                @id @default(autoincrement())
  order_id           Int
  changed_by_user_id Int?
  previous_status    orderstatushistory_previous_status
  new_status         orderstatushistory_new_status
  note               String?
  created_at         DateTime                           @default(now())
  user               user?                              @relation(fields: [changed_by_user_id], references: [id], map: "OrderStatusHistory_changed_by_user_id_fkey")
  order              order                              @relation(fields: [order_id], references: [id], map: "OrderStatusHistory_order_id_fkey")

  @@index([changed_by_user_id], map: "OrderStatusHistory_changed_by_user_id_fkey")
  @@index([order_id], map: "OrderStatusHistory_order_id_fkey")
}

model payment {
  id               Int                    @id @default(autoincrement())
  order_id         Int
  payment_method   payment_payment_method
  gateway_name     String?
  transaction_id   String?
  amount           Decimal                @db.Decimal(10, 2)
  currency         String
  status           payment_status         @default(pending)
  gateway_response String?
  paid_at          DateTime?
  created_at       DateTime               @default(now())
  updated_at       DateTime
  order            order                  @relation(fields: [order_id], references: [id], map: "Payment_order_id_fkey")

  @@index([order_id], map: "Payment_order_id_fkey")
}

model product {
  id                  Int             @id @default(autoincrement())
  product_category_id Int
  name                String
  slug                String          @unique(map: "Product_slug_key")
  sku                 String          @unique(map: "Product_sku_key")
  short_description   String?
  description         String?
  regular_price       Decimal         @db.Decimal(10, 2)
  sale_price          Decimal?        @db.Decimal(10, 2)
  cost_price          Decimal?        @db.Decimal(10, 2)
  stock_quantity      Int
  low_stock_threshold Int
  weight_grams        Int?
  average_rating      Float           @default(0)
  reviews_count       Int             @default(0)
  is_featured         Boolean         @default(false)
  is_visible          Boolean         @default(true)
  status              product_status  @default(active)
  meta_title          String?
  meta_description    String?
  created_at          DateTime        @default(now())
  updated_at          DateTime
  cartitem            cartitem[]
  productcategory     productcategory @relation(fields: [product_category_id], references: [id], map: "Product_product_category_id_fkey")
  productimage        productimage[]
  productreview       productreview[]

  @@index([product_category_id], map: "Product_product_category_id_fkey")
}

model productcategory {
  id               Int                       @id @default(autoincrement())
  name             String
  slug             String                    @unique(map: "ProductCategory_slug_key")
  description      String?
  image_url        String?
  image_public_id  String?
  image_alt_text   String?
  meta_title       String?
  meta_description String?
  sort_order       Int
  status           productcategory_status    @default(draft)
  is_visible       Boolean                   @default(false)
  created_at       DateTime                  @default(now())
  updated_at       DateTime
  giftTypes        GiftTypeProductCategory[]
  product          product[]
}

model productimage {
  id         Int      @id @default(autoincrement())
  product_id Int
  image_url  String
  public_id  String?
  alt_text   String?
  sort_order Int
  is_primary Boolean  @default(false)
  is_visible Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime
  product    product  @relation(fields: [product_id], references: [id], map: "ProductImage_product_id_fkey")

  @@index([product_id], map: "ProductImage_product_id_fkey")
}

model productreview {
  id                   Int       @id @default(autoincrement())
  product_id           Int
  user_id              Int
  order_item_id        Int
  rating               Int
  description          String
  status               String    @default("pending")
  is_verified_purchase Boolean   @default(false)
  admin_reply          String?
  admin_replied_at     DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime
  orderitem            orderitem @relation(fields: [order_item_id], references: [id], map: "ProductReview_order_item_id_fkey")
  product              product   @relation(fields: [product_id], references: [id], map: "ProductReview_product_id_fkey")
  user                 user      @relation(fields: [user_id], references: [id], map: "ProductReview_user_id_fkey")

  @@index([order_item_id], map: "ProductReview_order_item_id_fkey")
  @@index([product_id], map: "ProductReview_product_id_fkey")
  @@index([user_id], map: "ProductReview_user_id_fkey")
}

model riderprofile {
  id                  Int      @id @default(autoincrement())
  user_id             Int      @unique(map: "RiderProfile_user_id_key")
  vehicle_type        String?
  vehicle_number      String?
  availability_status String   @default("available")
  created_at          DateTime @default(now())
  updated_at          DateTime
  user                user     @relation(fields: [user_id], references: [id], map: "RiderProfile_user_id_fkey")
}

model sitesetting {
  id         Int      @id @default(autoincrement())
  key        String   @unique(map: "SiteSetting_key_key")
  value      String?
  value_json String?  @db.LongText
  group      String   @default("general")
  label      String?
  is_public  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime
}

model user {
  id                                                                  Int                         @id @default(autoincrement())
  full_name                                                           String
  email                                                               String                      @unique(map: "User_email_key")
  phone                                                               String?
  password_hash                                                       String?
  role                                                                user_role                   @default(CUSTOMER)
  auth_provider                                                       String
  google_id                                                           String?
  email_verified_at                                                   DateTime?
  status                                                              user_status                 @default(active)
  last_login_at                                                       DateTime?
  created_at                                                          DateTime                    @default(now())
  updated_at                                                          DateTime
  cart                                                                cart[]
  customeraddress                                                     customeraddress[]
  decorbooking                                                        decorbooking[]
  decorbookingstatushistory                                           decorbookingstatushistory[]
  decorquotation                                                      decorquotation[]
  decorreview                                                         decorreview[]
  decorteamassignment_decorteamassignment_assigned_by_user_idTouser   decorteamassignment[]       @relation("decorteamassignment_assigned_by_user_idTouser")
  decorteamassignment_decorteamassignment_assigned_user_idTouser      decorteamassignment[]       @relation("decorteamassignment_assigned_user_idTouser")
  deliveryotp                                                         deliveryotp[]
  notification                                                        notification[]
  order                                                               order[]
  orderriderassignment_orderriderassignment_assigned_by_user_idTouser orderriderassignment[]      @relation("orderriderassignment_assigned_by_user_idTouser")
  orderriderassignment_orderriderassignment_rider_user_idTouser       orderriderassignment[]      @relation("orderriderassignment_rider_user_idTouser")
  orderstatushistory                                                  orderstatushistory[]
  productreview                                                       productreview[]
  riderprofile                                                        riderprofile?
  verificationotp                                                     verificationotp[]
}

model verificationotp {
  id            Int       @id @default(autoincrement())
  user_id       Int
  email         String
  purpose       String
  otp_hash      String
  expires_at    DateTime
  attempt_count Int       @default(0)
  used_at       DateTime?
  created_at    DateTime  @default(now())
  user          user      @relation(fields: [user_id], references: [id], map: "VerificationOtp_user_id_fkey")

  @@index([user_id], map: "VerificationOtp_user_id_fkey")
}

